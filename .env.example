# ─────────────────────────────────────────────────────────────────────────────
# Configuración de entorno del Chatbot — Alcaldía de Floridablanca
#
# IMPORTANTE: Vite incrusta el valor de TODA variable que empiece por `VITE_`
# literalmente dentro del JavaScript compilado. `dist/assets/*.js` es un archivo
# estático público, así que cualquier persona puede descargarlo y leer esos valores.
#
# Regla: en `VITE_*` solo van datos que puedan ser públicos.
# NUNCA claves de API, tokens ni contraseñas. Los secretos son variables de RUNTIME.
#
# ─────────────────────────────────────────────────────────────────────────────
# QUIÉN LEE ESTE ARCHIVO
#
#   npm run dev          Vite lee las `VITE_*` para compilar el widget.
#   npm run start:local  Node lo carga entero (`--env-file-if-exists`), así que aquí
#                        puedes dejar las URLs de los RPA y no repetirlas en cada arranque.
#   npm start            NO lo lee. Es el arranque de producción: en Cloud Run la
#                        configuración llega por `--set-env-vars` y por Secret Manager.
#
# En el despliegue este archivo no existe: `.gitignore` lo deja fuera del repositorio y
# `.dockerignore` fuera de la imagen. Es deliberado — la configuración de un ambiente no
# viaja dentro de la imagen, porque entonces cambiar una URL exige reconstruirla.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# Variables base — exigidas por GOB-GCP-STD-01
#
# Se exponen en el endpoint /version del contenedor y acompañan a cada entrada de log,
# igual que en los microservicios FastAPI de la plataforma.
# ─────────────────────────────────────────────────────────────────────────────

# Nombre del servicio. Convención: [módulo]-[microservicio].
SERVICE_NAME=ia-chatbot-floridablanca
VITE_SERVICE_NAME=ia-chatbot-floridablanca

# Versión desplegada. En Cloud Build se inyecta el SHA corto del commit.
SERVICE_VERSION=0.0.0-dev
VITE_SERVICE_VERSION=0.0.0-dev

# Ambiente: qam | prem | prod | local
ENVIRONMENT=local
VITE_ENVIRONMENT=local

# Nivel de log del servidor: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Proyecto GCP, para correlacionar trazas en Cloud Logging.
GOOGLE_CLOUD_PROJECT=
VITE_GOOGLE_CLOUD_PROJECT=

# Puerto de escucha. Cloud Run lo inyecta automáticamente; en local usa 8080.
PORT=8080


# ─────────────────────────────────────────────────────────────────────────────
# Microservicios RPA — variables de RUNTIME, no de compilación
#
# Los dos servicios exigen un identity token de Google (IAM). El navegador no puede
# acuñar uno sin una llave de service account en el cliente, así que el widget NO los
# llama directamente: habla con el proxy de este mismo backend (`/rpa/factura`,
# `/rpa/pqrsd`), que pone el token.
#
# Por eso estas variables NO llevan prefijo `VITE_`: las lee el servidor en tiempo de
# ejecución. Si se definen como `VITE_*` no sirven de nada, y además quedarían fijas en
# el bundle —justo lo que ya rompió una vez, cuando renombrar `qa-rpa-pqrsd` a
# `qam-rpa-pqrsd` cambió el hash del host.
#
# La URL es también el `audience` del token. Debe ser la URL EXACTA, SIN barra final:
# una barra sobrante devuelve 401 y el 401 no dice por qué.
# ─────────────────────────────────────────────────────────────────────────────

# RPA de Impuesto Predial. En QAM: https://qam-rpa-factura-58937908768.us-central1.run.app
RPA_FACTURA_URL=http://localhost:8000

# RPA de PQRSD. En QAM: https://qam-rpa-pqrsd-ghlnutfdwq-uc.a.run.app
RPA_PQRSD_URL=http://localhost:8001

# ── Mecanismo de obtención del token ─────────────────────────────────────────
#
#   metadata    Cloud Run directo (QAM), o API Gateway cuyo `x-google-issuer` sea
#               `https://accounts.google.com`. El servidor de metadatos acuña el token
#               sin llaves. Es el valor correcto en cualquier ambiente desplegado.
#   gcloud      Solo desarrollo local contra los servicios reales. Acuña con la
#               credencial del desarrollador (`gcloud auth print-identity-token`), sin
#               llaves y sin tokens literales en el entorno.
#   none        Servicios locales sin IAM. No envía cabecera.
#   signed_jwt  API Gateway cuyo `x-google-issuer` sea el email de la SA del cliente.
#               NO IMPLEMENTADO: es otro mecanismo (IAM Credentials `signJwt` y el rol
#               `roles/iam.serviceAccountTokenCreator`). Confirmar con plataforma cuál de
#               las dos configuraciones tiene el gateway ANTES de necesitarlo.
RPA_AUTH_MODE=none

# Host del API Gateway. Vacío = se va directo a los Cloud Run (el caso de QAM).
# Al definirlo, los dos servicios se piden al gateway con el prefijo `/rpa/<servicio>` y
# el `audience` pasa a ser el host del gateway.
# PENDIENTE: confirmar con plataforma el host de PREM y PROD.
RPA_GATEWAY_URL=

# ── Sonda de arranque ────────────────────────────────────────────────────────
# strict  Un fallo de configuración (401, 403, 404 o variable ausente) corta el arranque.
#         Es el valor por defecto en cualquier ambiente distinto de `local`.
# warn    Registra y continúa.
# off     No sondea. Por defecto en `local`, donde lo normal es no tener los RPA levantados.
RPA_STARTUP_PROBE=off

# ── Control de gasto y de carga del proxy de los RPA ─────────────────────────
# El proxy es público y detrás hay trámites oficiales irreversibles y captchas pagados.

# Peticiones por minuto y por IP, cualquier ruta.
RPA_RATE_LIMIT_PER_MINUTE=30

# Trámites por hora y por IP (generar factura, seleccionar predio, radicar PQRSD).
RPA_EFFECTFUL_LIMIT_PER_HOUR=10

# Trámites de factura simultáneos. 2 es el techo real del servicio: corre con
# --max-instances=1 y dos workers de Playwright. El tercero recibe "estás en espera".
# OJO: el contador vive en la memoria del proceso, así que solo es un techo real si este
# chatbot también corre con --max-instances=1. Ver docs/INTEGRACION_RPA.md.
RPA_MAX_CONCURRENT_TRAMITES=2

# Tope del cuerpo de una radicación con anexos. El servicio admite 25 MB en total; el
# margen es para los delimitadores del multipart.
RPA_MAX_UPLOAD_BYTES=28311552


# ─────────────────────────────────────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────────────────────────────────────

# Origen del backend del chatbot, visto desde el navegador.
# Vacío = mismo origen que sirve el widget, que es el caso normal. Solo hace falta
# definirlo cuando el widget va incrustado en un portal de otro dominio.
VITE_BACKEND_ORIGIN=

# ─────────────────────────────────────────────────────────────────────────────
# Prefijo de ruta: SON DOS Y PUEDEN DIFERIR
#
# VITE_BASE_PATH  el prefijo PUBLICO, el que pide el navegador. Se incrusta en el
#                 bundle, asi que index.html y el CSS del embed lo llevan dentro.
#
# BASE_PATH       el que RECIBE el servidor, ya recortado por lo que haya delante.
#                 Se usa para quitarlo al enrutar.
#
# En QAM difieren, porque el balanceador recorta `/apig/qa`:
#   el navegador pide  .../apig/qa/chatbot/floridablanca/assets/embed.js
#   el servidor ve     /chatbot/floridablanca/assets/embed.js
#   entonces           VITE_BASE_PATH=/apig/qa/chatbot/floridablanca
#                      BASE_PATH=/chatbot/floridablanca
#
# Si nada recorta en medio, llevan el mismo valor. Vacias = servido en la raiz.
#
# COMO SE DIAGNOSTICA CUANDO ESTA MAL:
#   VITE_BASE_PATH mal -> el JS carga (importa su chunk de forma relativa) pero el
#                         CSS da 404 y el widget sale SIN ESTILOS.
#   BASE_PATH mal      -> no carga nada: todo cae al fallback de SPA y el navegador
#                         recibe HTML donde espera JS o CSS.
# ─────────────────────────────────────────────────────────────────────────────
VITE_BASE_PATH=
BASE_PATH=
BASE_PATH=

# Origen del proxy de IA, si algún día vive separado del resto del backend.
# Vacío = se usa VITE_BACKEND_ORIGIN.
VITE_AI_PROXY_URL=

# ¿Usar el proxy del backend para la IA? Activo por defecto en un build de producción,
# porque ahí el widget siempre lo sirve este mismo servidor y el proxy está en `/api/ai/chat`.
#
# No se deduce de VITE_AI_PROXY_URL: en el mismo origen esa URL es la cadena vacía, y sin
# esta bandera el despliegue caía en el modo de desarrollo y volvía a pedir la clave por el
# navegador —justo lo que el proxy existe para evitar—.
#
# `false` vuelve al modo de desarrollo: la clave la escribe el operador en el panel y queda
# en su navegador. Solo para trabajar sin backend levantado.
VITE_AI_PROXY_ENABLED=

# Backend del registro de conversaciones. Vacío = sin persistencia remota.
VITE_CONVERSATION_API_URL=

# Modo de persistencia: off | console | http
VITE_PERSISTENCE_MODE=off

# RETIRADAS: VITE_RPA_PREDIAL_API_URL y VITE_RPA_PQRSD_API_URL ya no se leen. Apuntar el
# navegador directo a un Cloud Run con IAM devuelve 403 en todas las llamadas. Si siguen
# definidas, el widget avisa por consola y las ignora.


# ─────────────────────────────────────────────────────────────────────────────
# Proxy de IA (Gemini)
# ─────────────────────────────────────────────────────────────────────────────

# Clave de Gemini. SECRETO: en Cloud Run se monta desde Secret Manager
# (`--set-secrets=GEMINI_API_KEY=gemini-api-key:latest`), nunca con --set-env-vars y
# nunca como VITE_*. Sin ella el proxy responde `ai_unavailable` y el widget atiende con
# el banco de preguntas frecuentes.
GEMINI_API_KEY=*****

# ─────────────────────────────────────────────────────────────────────────────
# BD de conversaciones (MySQL/MariaDB)
#
# PENDIENTE: provisionadas en infraestructura (cloudbuild.yaml, cada una con su
# substitution `_DB_*`) para el backend de registro de conversaciones descrito en
# REGISTRO_Y_IDENTIDAD.md §2 — ese backend aun no esta implementado en este repo, asi
# que estas variables todavia no las lee ningun codigo. Documentadas aqui para que
# quien lo implemente sepa que ya estan montadas y no las tenga que pedir de nuevo.
# ─────────────────────────────────────────────────────────────────────────────

# IP interna de la instancia (VM propia, no Cloud SQL). Requiere el conector VPC
# `vm-db-connection` (ya en cloudbuild.yaml) para ser alcanzable desde Cloud Run.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_NAME=

# SECRETO: en Cloud Run se monta desde Secret Manager
# (`--set-secrets=DB_PASS=<nombre-del-secreto>:latest`), nunca con --set-env-vars.
DB_PASS=*****

GEMINI_MODEL=gemini-2.5-flash-lite

# Ráfagas por IP. Frena bots y bucles de reintento.
AI_RATE_LIMIT_PER_MINUTE=10

# Ración diaria de respuestas de IA por sesión.
AI_DAILY_QUOTA_PER_SESSION=30

# Techo diario de tokens de todo el servicio: el cortacircuitos de gasto.
AI_DAILY_TOKEN_CEILING=500000


# ─────────────────────────────────────────────────────────────────────────────
# Red y orígenes
# ─────────────────────────────────────────────────────────────────────────────

# Portales autorizados a llamar al proxy de IA y al de los RPA, separados por comas.
# Un valor que empieza por punto es comodín de sufijo (`.floridablanca.gov.co`). El mismo
# origen que sirve el widget se permite siempre. NUNCA se responde con `*`.
#
# El portal de pruebas va explícito: `pruebas-se-floridablanca.nexura.com` no cae bajo el
# comodín `.floridablanca.gov.co`, son dominios distintos. Sin él, los trámites embebidos
# ahí responden 403 con `reason: forbidden_origin`.
ALLOWED_ORIGINS=.floridablanca.gov.co,pruebas-se-floridablanca.nexura.com

# Saltos de confianza en X-Forwarded-For. 2 = balanceador externo de GCP por delante de
# Cloud Run (el despliegue previsto). 1 = Cloud Run expuesto directo en *.run.app.
# Un valor incorrecto no da error: los límites por IP simplemente dejan de funcionar.
TRUSTED_PROXY_HOPS=2


# ─────────────────────────────────────────────────────────────────────────────
# Proxy de los RPA (server/rpaProxy.js) — variables de RUNTIME
#
# OJO con la diferencia: las `VITE_*` de arriba las lee el NAVEGADOR y quedan
# incrustadas en `dist/assets/*.js`. Estas las lee el SERVIDOR y nunca salen del
# contenedor. Por eso no llevan el prefijo `VITE_`, y no deben llevarlo nunca.
#
# El proxy existe porque el API Gateway protege las rutas de los RPA con
# `google_sa_jwt`, y un navegador no puede firmar ese token: exigiría la llave
# privada del service account dentro del bundle público. El servidor sí puede,
# pidiéndola al metadata server de Cloud Run.
# ─────────────────────────────────────────────────────────────────────────────

# Destino de las llamadas del proxy: el gateway o el Cloud Run del RPA de factura.
# Vacío deja las rutas de factura respondiendo `rpa_not_configured`; el widget sigue
# sirviéndose con normalidad.
RPA_PREDIAL_API_URL=

# Audiencia del JWT. Vacío significa "la misma URL de RPA_PREDIAL_API_URL", que es la
# convención al llamar a un Cloud Run. Si el destino es el API GATEWAY hay que fijarla
# aquí de forma explícita a la URL del gateway, o el token se rechaza.
RPA_PREDIAL_AUDIENCE=

# Peticiones por minuto y por IP hacia los RPA.
# Con el proxy en medio, el gateway ya no ve al ciudadano: ve a este servicio. O sea que
# este límite es lo único que separa al público del RPA, y cada llamada le cuesta al RPA
# una sesión de navegador contra el portal municipal.
RPA_RATE_LIMIT_PER_MINUTE=20

# Techo de espera de una llamada al RPA. El robot navega un portal externo y resuelve un
# captcha, así que es alto a propósito.
RPA_REQUEST_TIMEOUT_MS=60000


# ─────────────────────────────────────────────────────────────────────────────
# VITE_GEMINI_API_KEY — DELIBERADAMENTE AUSENTE
#
# La aplicación ya NO lee esta variable, y no debe volver a hacerlo.
#
# Antes se leía como valor por defecto de la clave, lo que la publicaba en claro dentro
# del bundle de producción (verificado: aparecía en `dist/assets/*.js`). Cualquier
# visitante podía extraerla y consumir la cuota de la Alcaldía.
#
# La solución definitiva ya está en el repositorio: el proxy `server/aiProxy.js` guarda la
# clave del lado del servidor. Con `GEMINI_API_KEY` definida, la clave no llega al
# navegador porque el bundle no la contiene.
#
# Nota sobre el `IMPORTANTE` de arriba: al añadir variables nuevas, léelas SIEMPRE con
# acceso estático — `import.meta.env.VITE_MI_VAR`. Un acceso dinámico como
# `import.meta.env[nombre]` impide la sustitución en tiempo de compilación y hace que Vite
# incruste el objeto de entorno COMPLETO, filtrando todas las variables.
# ─────────────────────────────────────────────────────────────────────────────
